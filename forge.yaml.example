# Forge Configuration
# Copy this file to `forge.yaml` and customize for your project.

name: my-project
language: rust

agents:
  # Default provider is Amazon Bedrock. Credentials come from the standard
  # AWS credential chain. Region is AWS_REGION (default us-east-1).
  # Nova Pro is the default model. Deployer and verifier use Nova Lite.
  # To opt into OpenAI for one agent, set a gpt-* model id and OPENAI_API_KEY.
  planner:
    model: us.amazon.nova-pro-v1:0
    max_tokens: 4096
    temperature: 0.2
  coder:
    model: us.amazon.nova-pro-v1:0
    max_tokens: 8192
    temperature: 0.2
  reviewer:
    model: us.amazon.nova-pro-v1:0
    max_tokens: 4096
    temperature: 0.1
    max_review_rounds: 3
  deployer:
    model: us.amazon.nova-lite-v1:0
    max_tokens: 4096
    temperature: 0.1
  verifier:
    model: us.amazon.nova-lite-v1:0
    max_tokens: 4096
    temperature: 0.1

deploy:
  target: superserve
  config:
    api_key: ${SUPERSERVE_API_KEY}
    image: debian:bookworm-slim
    memory_mb: 512
    vcpus: 2
    health_path: /health
    port: 8080

  # Alternative: direct Rust service target
  # target: rust-service
  # config:
  #   api_key: ${SUPERERSERVE_API_KEY}

  # Alternative: direct Python API target
  # target: python-api
  # config:
  #   api_key: ${SUPERSERVE_API_KEY}

runtime:
  max_pipeline_duration_ms: 600000  # 10 minutes
  max_agent_tokens: 16384
  max_shell_commands: 50
  allowed_shell_commands:
    - cargo
    - rustc
    - kubectl
    - npm
    - bun
    - python3
    - git

spacetime:
  host: https://spacetimedb.com
  database: "@sam/forge-7d0qe"
  # token: <optional-auth-token>